# Arduino build output
build/

# Windows installer build output
installer/output/
installer/work/

# Local runtime and scratch directories
.tmp-runtime/
tmp/

# Python caches
__pycache__/
*.py[cod]
.venv/
venv/

# Local configuration and diagnostics
.env
.env.*
!.env.example
*.log
*.tmp
*.bak

# Android local SDK/build output and synchronized release firmware
android/.gradle/
android/local.properties
android/app/build/
android/app/src/main/assets/firmware/*
!android/app/src/main/assets/firmware/.gitkeep
*.apk
*.aab

# Production data is local and may contain manufacturing identifiers
production_test/results/*.csv
results/*.csv

# Machine-specific Windows shortcuts
*.lnk

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
